+// WebOfShadowsRecomp native renderer (A2/B): copy the current-draw snapshot out of
+// the command processor into the light POD the title uses. Declared in the
+// standalone rex/graphics/vulkan/wos_native_snapshot.h so the title need not pull
+// in this heavy TU's headers. Pure read.
+void VulkanCommandProcessor::WosNativeA2ProofOnce() {
+  auto HX = [](auto h) -> uint64_t {
+    return uint64_t(reinterpret_cast<uintptr_t>(h));
+  };
+  const WosNativeDrawSnapshot& s = wos_native_draw_snapshot_;
+
+  REXGPU_INFO(
+      "[WoS-NATIVE-A2] p0 enter: valid={} pipe={:016X} layout={:016X} "
+      "rp={:016X} fb={:016X} {}x{} sets={} verts={} VS={:016X} PS={:016X}",
+      s.valid, HX(s.pipeline), HX(s.pipeline_layout), HX(s.render_pass),
+      HX(s.framebuffer), s.fb_width, s.fb_height, s.descriptor_set_count,
+      s.host_vertex_count, s.vertex_shader_hash, s.pixel_shader_hash);
+
+  for (uint32_t i = 0; i < s.descriptor_set_count && i < 4; ++i) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p0 set[{}] = {:016X}", i,
+                HX(s.descriptor_sets[i]));
+  }
+
+  if (!s.valid || s.pipeline == VK_NULL_HANDLE ||
+      s.pipeline_layout == VK_NULL_HANDLE || s.render_pass == VK_NULL_HANDLE ||
+      s.framebuffer == VK_NULL_HANDLE || s.fb_width == 0 || s.fb_height == 0) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p0 FAIL: snapshot incomplete; skipping proof");
+    return;
+  }
+  if (s.host_vertex_count == 0) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p0 FAIL: zero vertices; skipping proof");
+    return;
+  }
+
+  // Bind only the contiguous non-null prefix. current_graphics_descriptor_sets_
+  // holds VK_NULL_HANDLE for sets this pipeline doesn't use, and handing a null
+  // set to vkCmdBindDescriptorSets is a null deref inside the driver.
+  uint32_t bind_count = 0;
+  while (bind_count < s.descriptor_set_count && bind_count < 4 &&
+         s.descriptor_sets[bind_count] != VK_NULL_HANDLE) {
+    ++bind_count;
+  }
+  REXGPU_INFO("[WoS-NATIVE-A2] p1 binding {} of {} descriptor sets", bind_count,
+              s.descriptor_set_count);
+
+  const ui::vulkan::VulkanDevice* device_ptr = GetVulkanDevice();
+  if (!device_ptr) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p1 FAIL: no VulkanDevice");
+    return;
+  }
+  const ui::vulkan::VulkanDevice& device = *device_ptr;
+  const VkDevice dev = device.device();
+  const ui::vulkan::VulkanDevice::Functions& df = device.functions();
+  const uint32_t qfam = device.queue_family_graphics_compute();
+  REXGPU_INFO("[WoS-NATIVE-A2] p2 device={:016X} qfam={}", HX(dev), qfam);
+
+  VkCommandPool pool = VK_NULL_HANDLE;
+  VkCommandBuffer cmd = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+  auto cleanup = [&]() {
+    if (fence != VK_NULL_HANDLE) {
+      df.vkDestroyFence(dev, fence, nullptr);
+    }
+    if (pool != VK_NULL_HANDLE) {
+      df.vkDestroyCommandPool(dev, pool, nullptr);
+    }
+  };
+
+  VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pci.queueFamilyIndex = qfam;
+  pci.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+  if (df.vkCreateCommandPool(dev, &pci, nullptr, &pool) != VK_SUCCESS) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p3 FAIL: command pool");
+    cleanup();
+    return;
+  }
+  VkCommandBufferAllocateInfo cai{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  cai.commandPool = pool;
