+  cai.commandBufferCount = 1;
+  if (df.vkAllocateCommandBuffers(dev, &cai, &cmd) != VK_SUCCESS) {
+    REXGPU_INFO("[WoS-NATIVE-A2] p4 FAIL: cmd alloc");
+    cleanup();
+    return;
+  }
+  REXGPU_INFO("[WoS-NATIVE-A2] p5 cmd={:016X}", HX(cmd));
