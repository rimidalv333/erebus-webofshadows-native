+// Returns the bytes replaced from the base address (0 when nothing was replaced)
+template <typename Key>
+uint32_t WosTextureModsForLoad(memory::Memory& memory, const Key& key, uint32_t base_size,
+                               uint32_t mips_size) {
+  WosTextureMods& mods = WosMods();
+  const bool dump = REXCVAR_GET(wos_texture_dump);
+  if (!dump && mods.replacements.empty()) {
+    return 0;
+  }
+  if (!key.base_page || !base_size) {
+    return 0;
+  }
+  // The base level, and the mips that follow it in the same allocation when the
+  // texture keeps them there (packed or contiguous); mips elsewhere are left
+  const uint32_t base_address = key.base_page << 12;
+  uint32_t size = base_size;
+  if (key.mip_page && (key.mip_page << 12) == base_address + base_size) {
+    size += mips_size;
+  }
+  if (!dump && !mods.replacement_sizes.count(size)) {
+    return 0;
+  }
+  uint8_t* data = memory.TranslatePhysical(base_address);
+  if (!data) {
+    return 0;
+  }
+  const uint64_t hash = XXH3_64bits(data, size);
+  if (mods.replacements.count(hash)) {
+    const std::string path = WosModsRoot() + "/textures/" + fmt::format("{:016x}.bin", hash);
+    if (FILE* f = std::fopen(path.c_str(), "rb")) {
+      std::vector<uint8_t> replacement(size);
+      const size_t read = std::fread(replacement.data(), 1, size + 1, f);
+      std::fclose(f);
+      if (read == size) {
+        std::memcpy(data, replacement.data(), size);
+        REXGPU_INFO("Texture mods: replaced {:016x} ({}x{} format {})", hash, key.GetWidth(),
+                    key.GetHeight(), uint32_t(key.format));
+        return size;
+      } else {
+        REXGPU_WARN("Texture mods: {} is {} bytes, the texture {}: not used", path, read, size);
+      }
+    }
+    return 0;
+  }
+  if (!dump) {
+    return 0;
+  }
+  {
+    std::lock_guard lock(mods.lock);
+    if (!mods.dumped.insert(hash).second) {
+      return 0;
+    }
+  }
+  const std::string dir = WosModsRoot() + "/dump";
+  mkdir(WosModsRoot().c_str(), 0777);
+  mkdir(dir.c_str(), 0777);
+  // <hash>_f<format>_<width>x<height>_<t|l>_e<endian>_p<pitch>_m<mip levels>_<bytes>.bin
+  const std::string path = dir + fmt::format("/{:016x}_f{}_{}x{}_{}_e{}_p{}_m{}_{}.bin", hash,
+                                             uint32_t(key.format), key.GetWidth(), key.GetHeight(),
+                                             key.tiled ? "t" : "l", uint32_t(key.endianness),
+                                             uint32_t(key.pitch), uint32_t(key.mip_max_level) + 1,
+                                             size);
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(data, 1, size, f);
+    std::fclose(f);
+    chmod(path.c_str(), 0666);
+  }
+  return 0;
+}
