+struct WosTextureMods {
+  std::once_flag scanned;
+  std::unordered_set<uint64_t> replacements;
+  // 0020: the replacements' sizes - only a texture of one of them is hashed
+  std::unordered_set<uint32_t> replacement_sizes;
+  std::unordered_set<uint64_t> dumped;
+  std::mutex lock;
+};
+WosTextureMods& WosMods() {
+  static WosTextureMods mods;
+  std::call_once(mods.scanned, [] {
+    const std::string dir = WosModsRoot() + "/textures";
+    if (DIR* d = opendir(dir.c_str())) {
+      while (dirent* entry = readdir(d)) {
+        uint64_t hash = 0;
+        char tail[8] = {};
+        if (std::sscanf(entry->d_name, "%16llx%7s", reinterpret_cast<unsigned long long*>(&hash),
+                        tail) == 2 &&
+            std::string(tail) == ".bin") {
+          struct stat st;
+          if (stat((dir + "/" + entry->d_name).c_str(), &st) == 0 && st.st_size > 0) {
+            mods.replacements.insert(hash);
+            mods.replacement_sizes.insert(uint32_t(st.st_size));
+          }
+        }
+      }
+      closedir(d);
+    }
+    REXGPU_INFO("Texture mods: {} replacement(s) in {}", mods.replacements.size(), dir);
+  });
