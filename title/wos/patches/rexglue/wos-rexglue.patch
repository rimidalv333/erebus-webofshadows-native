+  rbi.renderArea.offset.x = 0;
+  rbi.renderArea.offset.y = 0;
+  rbi.renderArea.extent.width = s.fb_width;
+  rbi.renderArea.extent.height = s.fb_height;
+  rbi.clearValueCount = 8u;
