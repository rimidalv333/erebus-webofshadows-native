@@ -1392,8 +1392,19 @@ class PosixEvent : public PosixConditionHandle<Event> {
   void Pulse() override {
     using namespace std::chrono_literals;
     handle_.Signal();
+#if REX_PLATFORM_PS5
+    // WebOfShadowsRecomp (wos/patches/rexglue/0007): a 10 us sleep is far longer
+    // on the console, and Web of Shadows' job queue pulses events thousands of
+    // times a second from its main thread (a quarter of that thread's time was
+    // in NtPulseEvent). Give the waiters the same 10 us by yielding instead.
+    const auto until = std::chrono::steady_clock::now() + 10us;
+    do {
+      MaybeYield();
+    } while (std::chrono::steady_clock::now() < until);
+#else
     MaybeYield();
     Sleep(10us);
+#endif
     handle_.Reset();
   }
 };
