+// WebOfShadowsRecomp (wos/patches/rexglue/0011): recording a submission's
+// deferred commands into its Vulkan command buffer and submitting it (with
+// RADV on the PS5, the AGC submission alone took about a fifth of the command
+// processor's time) go to a thread of their own. Submissions stay in order;
+// swaps are submitted by the command processor after the ones before, so the
+// presenter's own submissions follow them; and a fence is waited for only once
+// its submission is made.
+struct WosAsyncSubmitter {
+  struct Job {
+    explicit Job(const VulkanCommandProcessor& command_processor) : stream(command_processor) {}
+    DeferredCommandBuffer stream;
+    VkCommandPool pool = VK_NULL_HANDLE;
+    VkCommandBuffer buffer = VK_NULL_HANDLE;
+    std::vector<VkSemaphore> wait_semaphores;
+    std::vector<VkPipelineStageFlags> wait_stage_masks;
+    VkFence fence = VK_NULL_HANDLE;
+  };
+
+  WosAsyncSubmitter(const VulkanCommandProcessor& command_processor)
+      : command_processor(command_processor) {
+    thread = std::thread([this] { Run(); });
+  }
+  ~WosAsyncSubmitter() {
+    {
+      std::lock_guard lock(mutex);
+      stop = true;
+    }
+    work_wanted.notify_all();
+    thread.join();
+  }
+
+  std::unique_ptr<Job> TakeJob() {
+    std::lock_guard lock(mutex);
+    if (free_jobs.empty()) {
+      return std::make_unique<Job>(command_processor);
+    }
+    std::unique_ptr<Job> job = std::move(free_jobs.back());
+    free_jobs.pop_back();
+    return job;
+  }
+
+  void Push(std::unique_ptr<Job> job) {
+    {
+      std::lock_guard lock(mutex);
+      jobs.push_back(std::move(job));
+    }
+    work_wanted.notify_one();
+  }
+
+  uint64_t Pending(bool drain) {
+    std::unique_lock lock(mutex);
+    if (drain) {
+      work_done.wait(lock, [this] { return jobs.empty() && !busy; });
+    }
+    return jobs.size() + (busy ? 1 : 0);
+  }
+
+  void Run() {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor.GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    const VkDevice device = vulkan_device->device();
+    std::unique_lock lock(mutex);
+    for (;;) {
+      work_wanted.wait(lock, [this] { return stop || !jobs.empty(); });
+      if (jobs.empty()) {
+        return;
+      }
+      std::unique_ptr<Job> job = std::move(jobs.front());
+      jobs.pop_front();
+      busy = true;
+      lock.unlock();
+
+      VkResult result = dfn.vkResetCommandPool(device, job->pool, 0);
+      if (result == VK_SUCCESS) {
+        VkCommandBufferBeginInfo begin_info = {};
+        begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+        begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        result = dfn.vkBeginCommandBuffer(job->buffer, &begin_info);
+      }
+      if (result == VK_SUCCESS) {
+        job->stream.Execute(job->buffer);
+        result = dfn.vkEndCommandBuffer(job->buffer);
+      }
+      if (result == VK_SUCCESS) {
+        VkSubmitInfo submit_info = {};
+        submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+        submit_info.waitSemaphoreCount = uint32_t(job->wait_semaphores.size());
+        submit_info.pWaitSemaphores =
+            job->wait_semaphores.empty() ? nullptr : job->wait_semaphores.data();
+        submit_info.pWaitDstStageMask =
+            job->wait_stage_masks.empty() ? nullptr : job->wait_stage_masks.data();
+        submit_info.commandBufferCount = 1;
+        submit_info.pCommandBuffers = &job->buffer;
+        ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+            vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+        result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job->fence);
+      }
+      if (result != VK_SUCCESS) {
+        REXGPU_ERROR("Vulkan async submission failed: {}", int(result));
+        if (result == VK_ERROR_DEVICE_LOST) {
+          device_lost = true;
+        }
+      }
+      job->stream.Reset();
+      job->wait_semaphores.clear();
+      job->wait_stage_masks.clear();
+
+      lock.lock();
+      free_jobs.push_back(std::move(job));
+      busy = false;
+      work_done.notify_all();
+    }
+  }
+
+  const VulkanCommandProcessor& command_processor;
+  std::mutex mutex;
+  std::condition_variable work_wanted;
+  std::condition_variable work_done;
+  std::deque<std::unique_ptr<Job>> jobs;
+  std::vector<std::unique_ptr<Job>> free_jobs;
+  bool busy = false;
+  bool stop = false;
+  std::atomic<bool> device_lost{false};
+  std::thread thread;
+};
