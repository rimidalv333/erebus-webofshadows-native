     const VulkanShader::SamplerBinding& binding) const {
+  struct Entry {
+    uint32_t fetch[6];
+    uint32_t filters;
+    int32_t anisotropic_override;
+    const VulkanTextureCache* cache;
+    SamplerParameters parameters;
+  };
+  static thread_local Entry entries[512];
+  const uint32_t* fetch =
+      &register_file().values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + binding.fetch_constant * 6];
+  const uint32_t filters = uint32_t(binding.mag_filter) | (uint32_t(binding.min_filter) << 4) |
+                           (uint32_t(binding.mip_filter) << 8) |
+                           (uint32_t(binding.aniso_filter) << 12) | (binding.fetch_constant << 16);
+  const int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  uint64_t hash = filters * 0x9E3779B97F4A7C15ull;
+  for (int i = 0; i < 6; ++i) {
+    hash = (hash ^ fetch[i]) * 0x100000001B3ull;
+  }
+  Entry& entry = entries[(hash >> 32) & 511];
+  if (entry.cache == this && entry.filters == filters &&
+      entry.anisotropic_override == anisotropic_override &&
+      std::memcmp(entry.fetch, fetch, sizeof entry.fetch) == 0) {
+    return entry.parameters;
+  }
+  SamplerParameters parameters = GetSamplerParametersUncached(binding);
+  std::memcpy(entry.fetch, fetch, sizeof entry.fetch);
+  entry.filters = filters;
+  entry.anisotropic_override = anisotropic_override;
+  entry.cache = this;
+  entry.parameters = parameters;
+  return parameters;
+}
