diff --git a/include/rex/graphics/vulkan/wos_native_snapshot.h b/include/rex/graphics/vulkan/wos_native_snapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..8b7f2208918e0e7947a782dfee98f0c7b620cee6
--- /dev/null
+++ b/include/rex/graphics/vulkan/wos_native_snapshot.h
@@ -0,0 +1,51 @@
+// WebOfShadowsRecomp native renderer (A2/B) -- a LIGHT, standalone view of the
+// emulated GPU's current-draw state, for the title's native renderer.
+//
+// The title must not include the full command_processor.h (it drags in the SPIR-V
+// translator / glslang headers that aren't on the title's include path). This
+// header exposes only a POD snapshot + a free getter, declared with lightweight
+// Vulkan + system types. The getter reads the command processor's internal
+// snapshot (populated in IssueDraw) and copies it out. Pure observation.
+//
+// Added by wos/patches/rexglue/0030-native-draw-snapshot.patch.
+#ifndef REX_GRAPHICS_VULKAN_WOS_NATIVE_SNAPSHOT_H_
+#define REX_GRAPHICS_VULKAN_WOS_NATIVE_SNAPSHOT_H_
+
+#include <cstdint>
+
+#include <rex/ui/vulkan/api.h>  // Vulkan types via the bundled headers + beta macros
+
+namespace rex {
+namespace system {
+class IGraphicsSystem;
+}  // namespace system
+namespace graphics {
+namespace vulkan {
+
+// POD mirror of VulkanCommandProcessor::WosNativeDrawSnapshot, fixed 4-set array.
+struct WosNativeSnapshot {
+  bool valid;
+  VkPipeline pipeline;
+  VkPipelineLayout pipeline_layout;
+  VkDescriptorSet descriptor_sets[4];
+  uint32_t descriptor_set_count;
+  uint32_t host_vertex_count;
+  uint64_t vertex_shader_hash;
+  uint64_t pixel_shader_hash;
+  VkRenderPass render_pass;
+  VkFramebuffer framebuffer;
+  uint32_t fb_width;
+  uint32_t fb_height;
+};
+
+// Copies the current-draw snapshot out of the graphics system's command processor.
+// Returns false if the graphics system / command processor is not a Vulkan one or
+// not up yet (out is left zeroed). Safe to call from the title (game) thread.
+bool WosNativeGetDrawSnapshot(system::IGraphicsSystem* graphics_system,
+                              WosNativeSnapshot* out);
+
+}  // namespace vulkan
+}  // namespace graphics
+}  // namespace rex
+
+#endif  // REX_GRAPHICS_VULKAN_WOS_NATIVE_SNAPSHOT_H_
diff --git a/include/rex/graphics/wos_probe_clock.h b/include/rex/graphics/wos_probe_clock.h
new file mode 100644
index 0000000000000000000000000000000000000000..39ba06f9ba7ec8587f91089ade5baba374b5c7df
--- /dev/null
+++ b/include/rex/graphics/wos_probe_clock.h
@@ -0,0 +1,42 @@
+// WebOfShadowsRecomp (wos/patches/rexglue/0013): the probes' clock. The TSC,
+// read directly (a few ns) instead of through steady_clock (clock_gettime and
+// chrono, which the profile showed at 5% of the GPU command processor's time),
+// scaled to nanoseconds by a factor measured once against steady_clock.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+#include <x86intrin.h>
+
+namespace rex::graphics::wos_probe {
+// WebOfShadowsRecomp (0028): the diagnostics master switch. Off by default, so a
+// release build pays nothing for the per-draw timing probes, the command
+// processor's idle/exec timing, or the title's per-frame perf log. The title
+// sets it from wos_recomp.toml (wos_diagnostics) before the game starts. Read
+// relaxed on the hot path - a predictable not-taken branch, no rdtsc and no
+// atomic add, when off.
+inline std::atomic<bool>& Enabled() {
+  static std::atomic<bool> enabled{false};
+  return enabled;
+}
+inline bool IsEnabled() { return Enabled().load(std::memory_order_relaxed); }
+
+inline double NsPerTick() {
+  static const double ns_per_tick = [] {
+    const auto c0 = std::chrono::steady_clock::now();
+    const uint64_t t0 = __rdtsc();
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    const auto c1 = std::chrono::steady_clock::now();
+    const uint64_t t1 = __rdtsc();
+    const double ns = double(std::chrono::duration_cast<std::chrono::nanoseconds>(c1 - c0).count());
+    return t1 > t0 ? ns / double(t1 - t0) : 1.0;
+  }();
+  return ns_per_tick;
+}
+inline uint64_t NowNs() {
+  return uint64_t(double(__rdtsc()) * NsPerTick());
+}
+}  // namespace rex::graphics::wos_probe
