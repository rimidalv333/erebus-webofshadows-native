+  REXGPU_INFO("[WoS-NATIVE-A2] p6 begin render pass");
+  df.vkCmdBeginRenderPass(cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+
+  REXGPU_INFO("[WoS-NATIVE-A2] p7 bind pipeline");
+  df.vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.pipeline);
+
+  // rexglue's guest pipelines enable dynamic viewport / scissor / depth bias /
+  // blend constants / stencil reference. Drawing with any of them never set is
+  // undefined behaviour and faults inside RADV, so set all of them.
+  VkViewport vp{};
