# WebOfShadowsRecomp for the PS5 - the game (included by wos/wos.cmake).
#
# Builds, for the title:
#
#   - the game's recompiled code, which `rexglue codegen wos_recomp_manifest.toml`
#     writes from the builder's own default.xex into WebOfShadowsRecomp's
#     generated/default (wos/tools/codegen.sh runs it): wos_recomp;
#   - the title's PS5 app (wos/app/): the game's ReXGlue app, its hooks, and
#     WebOfShadowsRecomp's unregistered guest function handler, compiled from the
#     builder's WebOfShadowsRecomp checkout: wos_app;
#   - ReXApp, which the SDK gives an app as a source to build (rexglue_configure_target).
#
# The title links the recompiled code with --wrap on the runtime's
# ResolveIndirectFunction (wos/app/wos_ps5_hooks.cpp guards invalid targets).
#
# SPDX-License-Identifier: MIT

set(wos_generated ${wos_src}/generated/default)
if(NOT EXISTS ${wos_generated}/sources.cmake OR NOT EXISTS ${wos_generated}/wos_recomp_init.h)
	message(FATAL_ERROR "No recompiled game code at ${wos_generated}: put your default.xex in "
		"${wos_src}/game, then run wos/tools/codegen.sh (or build the test app: -DWOS_TITLE_APP=test)")
endif()
if(NOT EXISTS ${wos_src}/src/stubs/unregistered_func_handler.h)
	message(FATAL_ERROR "No WebOfShadowsRecomp checkout at ${wos_src} (git clone "
		"https://github.com/toowasmir/WebOfShadowsRecomp beside this repository, or set WOS_WEBOFSHADOWS_SRC)")
endif()

# The PS5 maps memory at 64 KiB granularity, so the runtime maps the guest's
# 0xE0000000 range without its 4 KiB offset and the code must add it, as on
# Windows. The fork's codegen template says so for the PS5; code generated by an
# upstream rexglue does not, and every access above 0xE0000000 then misses by
# 4 KiB (PS5_EdgeOfTimeTitle's run 8): such a header is given the PS5 here.
set(wos_pch ${wos_generated}/wos_recomp_pch.h)
file(READ ${wos_pch} wos_pch_text)
if(wos_pch_text MATCHES "REX_ARCH_ARM64\\)\n#define REX_PHYS_HOST_OFFSET")
	string(REPLACE "#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n#define REX_PHYS_HOST_OFFSET"
		"#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64) || REX_PLATFORM_PS5\n#define REX_PHYS_HOST_OFFSET"
		wos_pch_text "${wos_pch_text}")
	file(WRITE ${wos_pch} "${wos_pch_text}")
	message(STATUS "WebOfShadowsRecomp: ${wos_pch} given the PS5's 0xE0000000 offset")
elseif(NOT wos_pch_text MATCHES "REX_PLATFORM_PS5")
	message(FATAL_ERROR "${wos_pch} has no REX_PHYS_HOST_OFFSET for the PS5 and is not in a form this build "
		"knows how to patch: run codegen with the rexglue the fork builds (wos/tools/codegen.sh)")
endif()

# The title's per-CPU "interrupts off" locks (wos/shim/wos_msr.h) replace the
# global ones at the end of the header: written into it, so that every file built
# with it is built again (a header CMake adds to the precompiled one is not
# tracked). Codegen writes the header afresh; configure runs again when it does.
set(wos_msr_include "#include \"${ROOT}/wos/shim/wos_msr.h\"  // WebOfShadowsRecomp: per-CPU MSR locks")
file(READ ${wos_pch} wos_pch_text)
string(FIND "${wos_pch_text}" "${wos_msr_include}" wos_msr_at)
if(wos_msr_at EQUAL -1)
	file(APPEND ${wos_pch} "\n${wos_msr_include}\n")
	message(STATUS "WebOfShadowsRecomp: ${wos_pch} given the per-CPU MSR locks")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${wos_pch})

# --- The game's recompiled code -------------------------------------------------

include(${wos_generated}/sources.cmake)
add_library(wos_recomp OBJECT ${GENERATED_SOURCES})
target_include_directories(wos_recomp PRIVATE ${wos_generated} ${wos_src} ${wos_rex_includes})
target_compile_definitions(wos_recomp PRIVATE ${wos_rex_definitions})
# As rexglue_apply_target_settings, at -O2 (the code is large). One section per
# object, not per function: with ~49,000 recompiled functions each in a .ltext.*
# section of its own, the linked ELF had 74,758 sections, past the 65,280 an ELF
# header counts, and PS5_Vulkan's native tool refused it ("ELF section table
# overruns input"). Every one of them is reached through the function table, so
# --gc-sections had nothing of theirs to drop anyway.
target_compile_options(wos_recomp PRIVATE ${wos_rex_options} -O2 -w
    -fno-function-sections -fno-data-sections)
# The small code model, not ReXGlue's large one: the whole title is about 105 MB,
# far inside the small model's 2 GB, and with the large model every one of the
# game's calls between its ~49,000 functions loads a 64-bit address and calls
# through a register. The main game thread is the limit (95% running its own code)
target_compile_options(wos_recomp PRIVATE -mcmodel=small)
target_precompile_headers(wos_recomp PRIVATE ${wos_pch})

# --- The title's PS5 app ------------------------------------------------------------

add_library(wos_app OBJECT ${ROOT}/wos/app/wos_ps5_app.cpp ${ROOT}/wos/app/wos_ps5_hooks.cpp ${ROOT}/wos/app/wos_ps5_threads.cpp ${ROOT}/wos/app/wos_ps5_pacing.cpp ${ROOT}/wos/app/wos_ps5_msr.cpp ${ROOT}/wos/app/wos_ps5_shader_dump.cpp ${ROOT}/wos/app/wos_ps5_native.cpp ${ROOT}/wos/app/wos_ps5_native_draw.cpp ${ROOT}/wos/app/wos_ps5_shader_harvest.cpp ${ROOT}/wos/app/wos_ps5_headless.cpp
	${ROOT}/wos/app/wos_ps5_native_renderer.cpp ${ROOT}/wos/app/wos_ps5_capture.cpp
	${wos_rexglue}/src/ui/rex_app.cpp)
# wos/shim first: WebOfShadowsRecomp's handler includes "hooks/perf_monitor.h",
# whose Windows original the shim stands in for
target_include_directories(wos_app PRIVATE ${ROOT}/wos/shim ${wos_src}/src ${wos_src} ${wos_generated}
	${wos_rex_includes})
target_compile_definitions(wos_app PRIVATE ${wos_rex_definitions})
target_compile_options(wos_app PRIVATE ${wos_rex_options} -O2)

# The native renderer: Edge of Time's, drawing the game (wos_native_renderer)
include(${ROOT}/wos/eot/wos_eot.cmake)

# A target's objects include its precompiled header's (.pch), which no link takes
set(wos_program_link_inputs "$<FILTER:$<TARGET_OBJECTS:wos_recomp>,INCLUDE,\\.o$>" $<TARGET_OBJECTS:wos_app>
	${wos_eot_link_inputs})
# The object files as well as their targets: a target alone orders the link
# after it but does not relink when only its objects changed
set(wos_program_link_depends wos_recomp wos_app ${wos_eot_link_depends} ${wos_program_link_inputs})
set(wos_program_link_flags --wrap=_ZN3rex7runtime23ResolveIndirectFunctionEj --wrap=__imp__VdSwap --wrap=clock_gettime
	# the kernel calls a game thread blocks in, timed per thread (wos/app/wos_ps5_threads.cpp)
	--wrap=__imp__KeWaitForSingleObject --wrap=__imp__KeWaitForMultipleObjects --wrap=__imp__NtWaitForSingleObjectEx --wrap=__imp__NtWaitForMultipleObjectsEx --wrap=__imp__KeDelayExecutionThread --wrap=__imp__NtYieldExecution --wrap=__imp__NtPulseEvent --wrap=__imp__RtlEnterCriticalSection --wrap=__imp__KfAcquireSpinLock --wrap=__imp__KeAcquireSpinLockAtRaisedIrql --wrap=__imp__NtReadFile --wrap=__imp__NtCreateFile
	# VideoOut's handle and each flip queued, for what the display shows (wos/app/wos_ps5_pacing.cpp)
	--wrap=sceVideoOutOpen --wrap=sceVideoOutSubmitFlip)
# clock_gettime is libkernel's: lld would export the wrapper, which the native tool
# refuses; it stays local (wos.cmake's version script)
set(wos_program_local_names __wrap_clock_gettime wos_profile_anchor __wrap_sceVideoOutOpen __wrap_sceVideoOutSubmitFlip)
