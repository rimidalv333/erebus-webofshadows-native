-    
-    return float4(0.0, 0.0, 0.0, index);
+    float x = value.z;
+    float y = value.w;
+    float z = value.x;
+    float ax = abs(x), ay = abs(y), az = abs(z);
+    float4 r;
+    if (az >= ax && az >= ay)
+        r = float4(-y, z < 0.0 ? -x : x, z, z < 0.0 ? 5.0 : 4.0);
+    else if (ay >= ax)
+        r = float4(y < 0.0 ? -z : z, x, y, y < 0.0 ? 3.0 : 2.0);
+    else
+        r = float4(-y, x < 0.0 ? z : -z, x, x < 0.0 ? 1.0 : 0.0);
+    r.z *= 2.0;
+    return r;
