+// WoS port: fetches whose instruction has tx_coord_denorm set take coordinates in texels
+// (the EDRAM restore/copy passes compute them from the pixel position): normalised here.
+float4 tfetch1DUnnorm(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float texCoord)
+{
+    uint width;
+    g_Texture1DDescriptorHeap[resourceDescriptorIndex].GetDimensions(width);
+    return tfetch1D(resourceDescriptorIndex, samplerDescriptorIndex, texCoord / float(max(width, 1u)));
+}
+
+float4 tfetch2DUnnorm(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
+{
+    float2 dimensions = float2(max(getTexture2DDimensions(g_Texture2DDescriptorHeap[resourceDescriptorIndex]), uint2(1, 1)));
+    return tfetch2D(resourceDescriptorIndex, samplerDescriptorIndex, texCoord / dimensions, offset);
+}
+
+float4 tfetch3DUnnorm(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float3 texCoord)
+{
+    uint3 dimensions;
+    g_Texture3DDescriptorHeap[resourceDescriptorIndex].GetDimensions(dimensions.x, dimensions.y, dimensions.z);
+    return tfetch3D(resourceDescriptorIndex, samplerDescriptorIndex, texCoord / float3(max(dimensions, uint3(1, 1, 1))));
+}
+
+float2 getWeights2DUnnorm(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
+{
+    return select(isnan(texCoord), 0.0, frac(texCoord + offset - 0.5));
+}
