@@ -434,6 +434,16 @@
     e = err;
 }
 
+// WoS port (fix100): Xenos (Direct3D 9) multiply - a product with a 0 operand is 0, even
+// times inf or NaN (IEEE: NaN). Used by the pixel shaders' mul/mad/dp/muls.
+float mulL(float a, float b) { return (a == 0.0 || b == 0.0) ? 0.0 : a * b; }
+float2 mulL(float2 a, float2 b) { return select(a == 0.0, 0.0, select(b == 0.0, 0.0, a * b)); }
+float3 mulL(float3 a, float3 b) { return select(a == 0.0, 0.0, select(b == 0.0, 0.0, a * b)); }
+float4 mulL(float4 a, float4 b) { return select(a == 0.0, 0.0, select(b == 0.0, 0.0, a * b)); }
+float dotL(float4 a, float4 b) { return dot(mulL(a, b), 1.0.xxxx); }
+float dotL(float3 a, float3 b) { return dot(mulL(a, b), 1.0.xxx); }
+float dotL(float2 a, float2 b) { return dot(mulL(a, b), 1.0.xx); }
+
 float dotF(float4 a, float4 b) { return dot(a, b); }
 float dotF(float3 a, float3 b) { return dot(a, b); }
 
